---
import config from '../../config.mjs';
import { professional } from '../data/professional.mjs';
import picture from '../assets/img/nutrizionista-emanuela-casula-cagliari.jpg';
import favicon from '../assets/img/website-icon.png';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel?: string;
  banner?: string;
  article?: boolean;
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
}
const { title, description, breadcrumbLabel = title, banner = picture.src,
  article = false, noindex = false, datePublished, dateModified } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') === '/404' ? '/404.html' : Astro.url.pathname === '/' || Astro.url.pathname.endsWith('.html')
  ? Astro.url.pathname : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const url = new URL(pathname, config.url).href;
const image = new URL(banner, config.url).href;
const personId = `${config.url}/#person`;
const businessId = `${config.url}/#studio`;
const websiteId = `${config.url}/#website`;
const breadcrumbs = [{ name: 'Home', url: `${config.url}/` }];
if (article) breadcrumbs.push({ name: 'Blog', url: `${config.url}/Blog/` });
if (pathname !== '/') breadcrumbs.push({ name: breadcrumbLabel, url });
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': personId, name: 'Emanuela Casula',
      jobTitle: 'Biologa Nutrizionista', url: `${config.url}/ChiSono/`,
      image: new URL(picture.src, config.url).href,
      workLocation: { '@id': businessId },
      sameAs: [professional.booking, 'https://iris.unica.it/cris/rp/rp29895?type=all', ...config.socialLinks.filter(link => ['Facebook', 'Instagram'].includes(link.name)).map(link => link.url)] },
    { '@type': 'MedicalBusiness', '@id': businessId, name: 'Emanuela Casula — Biologa Nutrizionista',
      url: `${config.url}/Contatti/`, telephone: professional.phone, image,
      address: { '@type': 'PostalAddress', streetAddress: professional.address.street,
        addressLocality: professional.address.city, postalCode: professional.address.postalCode,
        addressCountry: professional.address.country } },
    { '@type': 'WebSite', '@id': websiteId, url: `${config.url}/`,
      name: config.titleAlt, inLanguage: config.siteLanguage, publisher: { '@id': personId } },
    { '@type': article ? 'BlogPosting' : 'WebPage', '@id': `${url}#${article ? 'article' : 'webpage'}`,
      url, name: title, headline: article ? breadcrumbLabel : title, description, image,
      inLanguage: config.siteLanguage, isPartOf: { '@id': websiteId },
      author: { '@id': personId }, publisher: { '@id': personId },
      ...(article ? { mainEntityOfPage: url, datePublished, ...(dateModified ? { dateModified } : {}) } : {}) },
    ...(breadcrumbs.length > 1 ? [{ '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({ '@type': 'ListItem',
        position: index + 1, name: crumb.name, item: crumb.url })) }] : []),
  ],
};
const isProduction = import.meta.env.PROD;
---

<!doctype html>
<html lang={config.siteLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="image" content={image} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={config.titleAlt} />
    <meta property="og:locale" content={config.ogLanguage} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={description} />
    <meta name="theme-color" content={config.manifestThemeColor} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    {breadcrumbs.length > 1 && <nav class="breadcrumbs" aria-label="Percorso di navigazione"><ol>
      {breadcrumbs.map((crumb, index) => <li>{index === breadcrumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.url}>{crumb.name}</a>}</li>)}
    </ol></nav>}
    <slot />
    <script is:inline>
      setTimeout(() => {
        document.querySelector('.main-body')?.classList.remove('is-preload');
      }, 100);

      const menu = document.querySelector('#menu');
      const trigger = document.querySelector('.menuToggle');
      const container = document.querySelector('#nav')?.parentElement;
      function setMenu(open) {
        container?.classList.toggle('is-menu-visible', open);
        trigger?.setAttribute('aria-expanded', String(open));
        if (menu) menu.inert = !open;
        if (open) menu?.querySelector('a')?.focus();
        else trigger?.focus();
      }
      if (menu) menu.inert = true;
      trigger?.addEventListener('click', event => {
        event.preventDefault();
        setMenu(trigger.getAttribute('aria-expanded') !== 'true');
      });
      menu?.querySelector('.close')?.addEventListener('click', event => {
        event.preventDefault();
        setMenu(false);
      });
      menu?.addEventListener('keydown', event => {
        if (event.key === 'Escape') { event.preventDefault(); setMenu(false); }
        if (event.key === 'Tab') {
          const links = [...menu.querySelectorAll('a')];
          const first = links[0], last = links[links.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault(); last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault(); first.focus();
          }
        }
      });

      document.querySelectorAll('a[href="#cta"], a[href="#one"]').forEach(link => {
        link.addEventListener('click', event => {
          event.preventDefault();
          const target = document.querySelector(link.getAttribute('href'));
          const top = target ? target.getBoundingClientRect().top + window.pageYOffset : 0;
          window.scroll({ top, left: 0, behavior: 'smooth' });
        });
      });

    </script>
    <script is:inline define:vars={{ isProduction }}>
      if ('serviceWorker' in navigator) {
        if (isProduction) {
          window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
        } else {
          navigator.serviceWorker.getRegistrations().then(registrations => {
            registrations.forEach(registration => registration.unregister());
          });

          if ('caches' in window) {
            caches.keys().then(keys => {
              keys
                .filter(key => key.startsWith('nutrizionista-emanuela-casula-'))
                .forEach(key => caches.delete(key));
            });
          }
        }
      }
    </script>
  </body>
</html>
