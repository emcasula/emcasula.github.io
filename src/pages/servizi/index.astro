---
import ServiceTile from '../../components/ServiceTile.astro';
import ContentPage from '../../layouts/ContentPage.astro';
import { getPublishedContent } from '../../lib/content';
const { services } = await getPublishedContent();
---
<ContentPage title="Servizi e percorsi nutrizionali a Cagliari | Emanuela Casula" heading="Servizi" label="Servizi"
  description="Scopri i percorsi di Emanuela Casula a Cagliari: nutrizione sportiva, ricomposizione corporea, valutazione della composizione corporea e prima visita.">
  <div class="service-grid">
    {services.map(service => <ServiceTile service={service} />)}
  </div>
</ContentPage>
<style>
  .service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2em; grid-auto-rows: 1fr; }
  @media (max-width: 736px) { .service-grid { grid-template-columns: 1fr; grid-auto-rows: auto; gap: 1.5em; } }
</style>
