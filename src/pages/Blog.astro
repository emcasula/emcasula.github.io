---
import BlogCard from '../components/BlogCard.astro';
import PageShell from '../layouts/PageShell.astro';
import { getPublishedContent } from '../lib/content';
const { posts } = await getPublishedContent();
---
<PageShell title="Blog di nutrizione | Emanuela Casula" description="Articoli di Emanuela Casula su nutrizione, allenamento e valutazione della composizione corporea." breadcrumbLabel="Blog">
  <article id="main" role="main">
    <header><h1>Blog</h1></header>
    <section class="wrapper style5"><div class="inner">
      {posts.length === 0 && <p>Non ci sono ancora articoli pubblicati.</p>}
      <div class="blog-grid">
        {posts.map((post, index) => <BlogCard post={post} eager={index === 0} />)}
      </div>
    </div></section>
  </article>
</PageShell>

<style>
  .blog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2em; }
  @media (min-width: 1281px) { .blog-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 736px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
