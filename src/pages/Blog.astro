---
import PageShell from '../layouts/PageShell.astro';
import BlogPage from '../react-pages/Blog.jsx';
import { getBlogPosts } from '../lib/blog.mjs';

const edges = getBlogPosts().map(post => ({ node: post }));
const data = { allMarkdownRemark: { edges } };
---

<PageShell title="Blog di nutrizione | Emanuela Casula" description="Articoli di Emanuela Casula su nutrizione, allenamento e valutazione della composizione corporea." breadcrumbLabel="Blog">
  <BlogPage data={data} />
</PageShell>
